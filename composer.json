{
	"name": "pbl-trpl-106/galonku",
	"description": "Frontend Galonku - Aplikasi Pengelolaan Depot Air Minum",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.64",
		"matthiasmullie/minify": "^1.3",
		"phpstan/phpstan": "^2.0"
	},
	"scripts": {
		"build": "php build.php",
		"clean": "rm -f src/build-info.php",
		"fmt": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
		"fmt-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
		"stan": "phpstan analyse --memory-limit=256M --no-progress",
		"dist": "php bin/build-dist.php",
		"clean-dist": "rm -rf dist"
	},
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true
	}
}
